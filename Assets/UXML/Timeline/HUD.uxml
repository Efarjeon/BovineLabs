<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI">
    <appui:Panel theme="dark" scale="medium" style="flex-grow: 1; justify-content: flex-end; align-items: flex-end; padding: 20px; pointer-events: none;">
        <!-- This is the container we will target from the Timeline -->
        <ui:VisualElement name="minimap-container" style="width: 250px; height: 250px; background-color: rgba(0, 0, 0, 0.5); border-radius: 12px; overflow: hidden; pointer-events: all;" />
    </appui:Panel>
</ui:UXML>
